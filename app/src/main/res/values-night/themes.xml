<resources>
    <!-- Base application theme. -->
    <style name="Theme.VocabNotes" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue</item>
        <item name="colorPrimaryContainer">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSurface">@color/primary_dark</item>
        <item name="colorSurfaceContainer">@color/primary_dark</item>
        <item name="colorSurfaceVariant">@color/light_black</item>
        <item name="android:colorBackground">@color/primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/onPrimary_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- Customize your theme here. -->
        <item name="actionBarStyle">@style/Widget.App.ActionBar.Dark</item>
        <item name="popupTheme">@style/Theme.VocabNotes.PopupOverlay</item>
        <item name="colorControlNormal">@color/onPrimary_dark</item>
    </style>

    <style name="Widget.App.ActionBar.Dark" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary_dark</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/onPrimary_dark</item>
        <item name="android:iconTint">@color/onPrimary_dark</item>
        <item name="android:actionOverflowMenuStyle">@color/onPrimary_dark</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Theme.VocabNotes.PopupOverlay" parent="ThemeOverlay.Material3">
        <item name="android:backgroundTint">@color/popup_dark</item>
        <item name="colorOnSurface">@color/onPrimary_dark</item>
    </style>

    <style name="Theme.VocabNotes.Toolbar" parent="Widget.Material3.Toolbar.OnSurface">
        <item name="android:background">@color/primary</item>

    </style>

</resources>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.VocabNotes" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryVariant">@color/blue</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <!-- Customize your theme here. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorOnContainer">@color/black</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="tintNavigationIcon">@color/black</item>
        <item name="android:iconTint">@color/black</item>
        <item name="iconTint">@color/black</item>
        <item name="actionMenuTextColor">@color/black</item>
    </style>

    <style name="Theme.VocabNotes.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.VocabNotes.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.VocabNotes.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
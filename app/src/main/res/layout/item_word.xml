<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:swipe="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    swipe:leftEdgeSwipeOffset="0dp"
    swipe:rightEdgeSwipeOffset="0dp">

    <!-- Bagian tersembunyi (akan muncul ketika swipe) -->
    <LinearLayout
        android:id="@+id/layout_hidden"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#EFE400"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnFav"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Fav"
            android:padding="16dp"
            android:src="@drawable/outline_star_border_24"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Konten utama -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1" />

        <TextView
            android:id="@+id/tv_number_hid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="999"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintEnd_toStartOf="@+id/card_pos"
            app:layout_constraintStart_toEndOf="@+id/tv_number_hid"
            app:layout_constraintTop_toTopOf="@+id/tv_number_hid">

            <TextView
                android:id="@+id/tv_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/tv_pronun"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="obnoxious" />

            <TextView
                android:id="@+id/tv_pronun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawablePadding="8dp"
                android:textColor="#646464"
                android:textSize="12sp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/tv_word"
                app:layout_constraintStart_toEndOf="@+id/tv_word"
                app:layout_constraintTop_toTopOf="@+id/tv_word"
                tools:text="@string/underline" />

            <View
                android:id="@+id/underline"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="-2dp"
                android:background="#646464"
                app:layout_constraintEnd_toEndOf="@id/tv_pronun"
                app:layout_constraintStart_toStartOf="@id/tv_pronun"
                app:layout_constraintTop_toBottomOf="@id/tv_pronun" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_meaning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/teal_700"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@+id/ll_word"
            app:layout_constraintTop_toBottomOf="@+id/ll_word"
            tools:text="menjengkelkan" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_pos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="4dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true"
            app:contentPadding="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_word">

            <TextView
                android:id="@+id/tv_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/purple_200"
                android:textSize="12sp"
                tools:text="adjective" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.daimajia.swipe.SwipeLayout>